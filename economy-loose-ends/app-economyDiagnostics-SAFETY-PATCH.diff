+  // Three period states, not two. A save that has never committed anything has ledger period 0
+  // against a real `createdWeek`, which is a MISMATCH — and calling that "graduated" would be
+  // alarming nonsense on every fresh save.
+  const nothingCommitted = input.committedPence === 0 && input.entryCount === 0
+    && input.ledgerPeriodWeek === 0;
