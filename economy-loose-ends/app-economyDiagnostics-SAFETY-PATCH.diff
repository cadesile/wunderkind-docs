+  const nonRefundable = input.committedPence - input.entriesPence;
+  const entriesFit = nonRefundable >= 0;
+
+  const p = (n: number) => n.toLocaleString();
+
+  return [
+    {
+      id: 'dof.pot',
+      label: 'DOF pot (opening · committed · pot · next rebalance)',
+      status: potImpossible ? 'fail' : 'info',
+      detail: `opening ${p(input.openingPence)} · committed ${p(input.committedPence)}`
+        + ` · pot ${p(input.potPence)} · next rebalance ${p(nextDerivation)}`
+        + ` · period wk ${input.ledgerPeriodWeek} vs budget wk ${input.budgetCreatedWeek}`
+        + ` — ${periodState}`
+        + (potImpossible
+          ? ' — IMPOSSIBLE: the pot exceeds its own opening allocation while money is still'
+            + ' committed out of it, so a refund has credited back more than it took'
+          : ''),
+    },
+    {
+      id: 'dof.commitments',
+      label: 'DOF pot ledger (entries never claim more than the total holds)',
+      status: entriesFit ? 'pass' : 'fail',
+      detail: `${input.entryCount} refundable ${input.entryCount === 1 ? 'entry' : 'entries'}`
+        + ` · refundable ${p(input.entriesPence)} · committed ${p(input.committedPence)}`
+        + (entriesFit
+          ? ` · non-refundable ${p(nonRefundable)} (weeks already used, plus any charge drawn`
+            + ' with no subjectId) — FITS'
+          : ` — DISAGREE by ${p(-nonRefundable)}: entries claim more than the total holds, so a`
+            + ' refund would be over-refunded and floored'),
+    },
+  ];
