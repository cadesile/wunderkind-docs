+export function dofPotChecks(input: {
+  /** `Math.floor(allocatableBalancePence × transferBudgetPercent / 100)`. */
+  openingPence: number;
+  /** `carriedDofWageCommitmentPence(state)` — 0 once the period has rolled. */
+  committedPence: number;
+  /** `clubStore.transferBudget` as it actually stands. */
+  potPence: number;
+  /** The period the stored total belongs to, `dofWageCommitmentPeriodWeek`. */
+  ledgerPeriodWeek: number;
+  /** The club's own `seasonBudget.createdWeek`, 0 when no budget has been derived. */
+  budgetCreatedWeek: number;
+  /** `liveDofWageCommitments(state)` — count and summed original charges. */
+  entryCount: number;
+  entriesPence: number;
+}): EconomyCheck[] {
+  const nextDerivation = Math.max(0, input.openingPence - input.committedPence);
+  // A pot larger than its own opening allocation, with money still committed out of it, cannot
+  // be legitimate: the refund is the only thing that credits `transferBudget` upward, and it can
+  // only ever give back weeks it took. (A grant can exceed the opening, but not while a
+  // commitment is outstanding and unspent — and if it does, it is worth a look either way.)
+  const potImpossible = input.committedPence > 0 && input.potPence > input.openingPence;
